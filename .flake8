[flake8]
max-line-length = 100

extend-ignore =
    E203,
    W503,
    F403,
    F405

exclude =
    .git,
    __pycache__,
    .venv,
    migrations,
    htmlcov,
    backend/tests,
    backend/infrastructure/ml/dataset_builder,
    backend/infrastructure/ml/train_*.py

per-file-ignores =
    backend/domain/models/__init__.py:F401
    backend/infrastructure/__init__.py:W391
    backend/infrastructure/ml/__init__.py:W391
    backend/app/routes/common.py:F401,F811